{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "@fastly/js-compute",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "../src/**/*.ts"
  ],
  "exclude": [
    // Type-checked per SDK version by build-apps.mjs, against the packed library
    "integration/app",
    "integration/.work"
  ]
}
