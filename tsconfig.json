{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "build",
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "types": [
      "@fastly/js-compute"
    ],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
